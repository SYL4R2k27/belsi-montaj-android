@app.post("/foreman/invites", response_model=ForemanInviteOut)
def create_foreman_invite(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """
    Создаёт новый инвайт-код для бригадира.

    Ограничения:
    - максимум 10 активных инвайтов (new/accepted, не истёкшие);
    - код уникальный (по полю code).
    """
    foreman_phone = current_user.phone

    # 1. Проверяем лимит активных инвайтов
    active_count = _get_foreman_active_invites_count(db, foreman_phone)
    if active_count >= 10:
        raise HTTPException(
            status_code=400,
            detail="Вы уже создали максимальное количество активных инвайт-кодов (10). "
                   "Отмените один из существующих, чтобы создать новый.",
        )

    # 2. Генерируем уникальный код
    max_attempts = 10
    code = None
    for _ in range(max_attempts):
        candidate = _generate_invite_code()
        existing = db.query(ForemanInvite).filter(ForemanInvite.code == candidate).first()
        if not existing:
            code = candidate
            break

    if code is None:
        raise HTTPException(
            status_code=500,
            detail="Не удалось сгенерировать уникальный инвайт-код. "
                   "Попробуйте ещё раз или обратитесь в поддержку.",
        )

    # 3. Создаём запись
    now = _get_now_utc()
    expires_at = now + timedelta(days=3)

    invite = ForemanInvite(
        code=code,
        foreman_phone=foreman_phone,
        foreman_user_id=current_user.id,   # <<< ВОТ ЭТО ДОБАВИТЬ
        installer_phone=None,
        installer_user_id=None,
        created_at=now,
        expires_at=expires_at,
        used_at=None,
        status="new",
    )
    db.add(invite)
    db.commit()
    db.refresh(invite)

    return ForemanInviteOut.from_orm(invite)


@app.get("/foreman/invites", response_model=ForemanInviteListOut)
def list_foreman_invites(
    status: Optional[str] = Query(
        None,
        description="Фильтр по статусу: new / accepted / cancelled / expired",
    ),
    only_active: bool = Query(
        False,
        description="Если true — только активные (new/accepted, не истёкшие)",
    ),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """
    Возвращает список инвайтов бригадира.

    Параметры:
    - status: фильтр по статусу (например, ?status=new)
    - only_active: если true — только активные (new/accepted, не истёкшие).

    Если параметры не заданы — возвращаем все инвайты бригадира.
    """
    foreman_phone = current_user.phone
    now = _get_now_utc()

    query = db.query(ForemanInvite).filter(ForemanInvite.foreman_phone == foreman_phone)

    if status is not None:
        query = query.filter(ForemanInvite.status == status)

    if only_active:
        query = query.filter(
            ForemanInvite.status.in_(["new", "accepted"]),
            or_(ForemanInvite.expires_at.is_(None), ForemanInvite.expires_at > now),
        )

    invites = query.order_by(ForemanInvite.created_at.desc()).all()

    return ForemanInviteListOut(
        items=[ForemanInviteOut.from_orm(i) for i in invites]
    )


@app.post("/foreman/invites/redeem", response_model=ForemanInviteOut)
def redeem_foreman_invite(
    payload: dict,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """
    Монтажник вводит инвайт-код и «привязывается» к бригадиру.

    Логика:
    - находим инвайт по коду;
    - проверяем, что не истёк;
    - проверяем, что статус new;
    - ставим installer_phone = текущий пользователь;
    - статус -> accepted, used_at = сейчас.
    """
    code = payload.get("code")
    if not code:
        raise HTTPException(
            status_code=400,
            detail="Не передан инвайт-код.",
        )

    invite = _find_invite_by_code_for_redeem(db, code)
    if invite is None:
        raise HTTPException(
            status_code=404,
            detail="Инвайт-код не найден. Проверьте, правильно ли он введён.",
        )

    now = _get_now_utc()

    # Проверяем истечение срока действия
    if invite.expires_at is not None and invite.expires_at <= now:
        invite.status = "expired"
        db.commit()
        raise HTTPException(
            status_code=400,
            detail="Срок действия инвайт-кода истёк. Попросите бригадира создать новый.",
        )

    # Проверяем статус
    if invite.status != "new":
        raise HTTPException(
            status_code=400,
            detail="Инвайт-код уже использован или отменён. Попросите бригадира выдать новый.",
        )

    # Всё ок — принимаем код
    invite.installer_user_id = current_user.id
    invite.installer_phone = current_user.phone
    invite.used_at = datetime.now(timezone.utc)
    invite.status = "accepted"
    
    db.commit()
    db.refresh(invite)

    return ForemanInviteOut.from_orm(invite)


@app.post("/foreman/invites/cancel", response_model=ForemanInviteOut)
def cancel_foreman_invite(
    payload: dict,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """
    Бригадир отменяет свой инвайт-код.

    Можно отменить только:
    - свой код (по номеру foreman_phone);
    - в статусе new (ещё никто не принял).
    """
    code = payload.get("code")
    if not code:
        raise HTTPException(
            status_code=400,
            detail="Не передан инвайт-код для отмены.",
        )

    foreman_phone = current_user.phone
    invite = _find_invite_by_code_for_foreman(db, code, foreman_phone)

    if invite is None:
        raise HTTPException(
            status_code=404,
            detail="Инвайт-код не найден или не принадлежит вашему номеру.",
        )

    # Проверяем статус
    if invite.status != "new":
        raise HTTPException(
            status_code=400,
            detail="Инвайт-код уже был использован, отменён или истёк.",
        )

    invite.status = "cancelled"
    db.commit()
    db.refresh(invite)

    return ForemanInviteOut.from_orm(invite)

