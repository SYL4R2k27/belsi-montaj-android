# ==================== УТИЛИТЫ ====================


def normalize_phone(raw: str) -> str:
    """
    Приводим телефон к единому формату: +7XXXXXXXXXX
    (сейчас работаем только с РФ; при необходимости расширим).
    """
    digits = re.sub(r"\D", "", raw or "")
    if not digits:
        return ""

    # 89XXXXXXXXX -> 79XXXXXXXXX
    if digits.startswith("8") and len(digits) == 11:
        digits = "7" + digits[1:]

    if not digits.startswith("7") or len(digits) != 11:
        # сюда можно добавить обработку других стран
        return ""

    return "+" + digits


def make_demo_token(phone: str) -> str:
    return f"demo-token-{phone}"


def parse_demo_token(token: str) -> str:
    prefix = "demo-token-"
    if not token.startswith(prefix):
        raise ValueError("Invalid demo token")
    return token[len(prefix) :]


def get_or_create_user(db: Session, phone: str, default_role: str = "installer") -> User:
    user = db.query(User).filter(User.phone == phone).one_or_none()
    if user is None:
        user = User(phone=phone, role=default_role)
        db.add(user)
        db.commit()
        db.refresh(user)
    return user


def get_current_user(
    credentials: HTTPAuthorizationCredentials = Depends(security),
    db: Session = Depends(get_db),
) -> User:
    if credentials is None or credentials.scheme.lower() != "bearer":
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Not authenticated",
        )

    token = credentials.credentials.strip()
    try:
        phone_raw = parse_demo_token(token)
    except ValueError:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid token",
        )

    phone = normalize_phone(phone_raw)
    if not phone:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid phone in token",
        )

    return get_or_create_user(db, phone)


