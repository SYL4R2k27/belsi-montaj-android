# ==== PostgreSQL ====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=default_db
DB_USER=gen_user
DB_PASSWORD=

# ==== Redis ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# ==== S3 ====
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ==== API URL ====
API_BASE_URL=https://api.belsi.ru
SMSRU_API_ID=

# ==== XeroCode AI Gateway (BELSI 1.3.0) ====
# Адрес AI-шлюза XeroCode (российский провайдер AI-функций).
XEROCODE_API_URL=https://xerocode.ru/api/v1/external

# Service-token выдаёт XeroCode admin endpoint POST /api/admin/service-accounts.
# Формат: 'belsi_<8chars>_<32chars>'. Один раз показывается при создании.
XEROCODE_SERVICE_TOKEN=

# Таймаут одного запроса (сек). Для transcribe внутри клиента используется 90 сек.
XEROCODE_TIMEOUT_SEC=30

# Feature flag. При false ВСЕ AI-вызовы становятся no-op без ошибок.
# Используем для emergency-вырубания при сбоях XeroCode.
XEROCODE_ENABLED=true
